!/Assets/CityForge/Scripts/Editor.meta
!/Assets/CityForge/Scripts/Environment.meta
!/Assets/CityForge/Scripts/UI.meta
!/Assets/CityForge/Scripts/World.meta
!/Assets/CityForge/Scripts.meta
!/Assets/CityForge.meta

# Authored relief shader only; biome artwork remains local.
!/Assets/CityForge/Resources/
/Assets/CityForge/Resources/**
!/Assets/CityForge/Resources/Region/
!/Assets/CityForge/Resources.meta
!/Assets/CityForge/Resources/Region.meta
