# Authored river preview settings; contains no licensed artwork.
!/Assets/CityForge/Scripts/Editor/RiverSunGlintPreview.json
!/Assets/CityForge/Scripts/Editor/RiverSunGlintPreview.json.meta

# Local generated Crest shader experiments; never publish licensed generated source.
